};

&cpu30100 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_ACPU_3>;
	/delete-property/ operating-points-v2;
};

&can0 {
	clocks = <&can0_clk>, <&scmi_clk SCMI_CLK_VERSAL2_LPD_LSBUS>;
	power-domains = <&scmi_devpd SCMI_PD_VERSAL2_DEV_CAN_FD_0>;
};

