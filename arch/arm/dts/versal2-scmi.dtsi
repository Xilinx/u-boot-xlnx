#include "versal2-scmi-clk.h"
#include "versal2-scmi-power.h"
#include "versal2-scmi-reset.h"

/ {
	#address-cells = <2>;
	#size-cells = <2>;

	/* SCMI shared memory carve-out, shared with TF-A and Linux */
	scmi_buf: scmi-shmem@20001000 {
		compatible = "arm,scmi-shmem";
		reg = <0x0 0x20001000 0x0 0x1000>;
		no-map;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;

		scmi_buffer: memory@20000000 {
			no-map;
			reg = <0x0 0x20000000 0x0 0x20000>;
		};
	};

	firmware {
		scmi: scmi { /* Should be injected by firmware */
			compatible = "arm,scmi-smc";
			arm,smc-id = <0xc2002001>;
			#address-cells = <1>;
			#size-cells = <0>;
			shmem = <&scmi_buf>;

			/* Ensures the SCMI agent is probed before reloc and the serial device */
			bootph-all;

			scmi_reset: protocol@16 {
				reg = <0x16>;
				#reset-cells = <1>;
			};

			scmi_devpd: protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <1>;
			};

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
			};
		};

		versal2_firmware: versal2-firmware {
			compatible = "xlnx,versal2-firmware";
			bootph-all;
			method = "smc";
			#power-domain-cells = <1>;

			versal2_reset: reset-controller {
				compatible = "xlnx,versal-reset";
				status = "disabled";
				#reset-cells = <1>;
			};

			versal2_clk: clock-controller {
				#clock-cells = <1>;
				status = "disabled";
				compatible = "xlnx,versal2-clk";
				bootph-all;
				clocks = <&ref_clk>, <&ref_clk>;
				clock-names = "ref", "pl_alt_ref";
			};

			versal_net_power: power-management {
				compatible = "xlnx,zynqmp-power";
				status = "disabled";
				interrupt-parent = <&gic>;
				interrupts = <0 57 4>;
				mboxes = <&ipi_mailbox_pmu1 0>,
					 <&ipi_mailbox_pmu1 1>;
				mbox-names = "tx", "rx";
			};

			versal_sec_cfg: versal-sec-cfg {
				compatible = "xlnx,versal-sec-cfg";
				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					bbram_zeroize: bbram-zeroize@4 {
						reg = <0x04 0x4>;
					};

					bbram_key: bbram-key@10 {
						reg = <0x10 0x20>;
					};

					bbram_usr: bbram-usr@30 {
						reg = <0x30 0x4>;
					};

					bbram_lock: bbram-lock@48 {
						reg = <0x48 0x4>;
					};

					user_key0: user-key@110 {
						reg = <0x110 0x20>;
					};

					user_key1: user-key@130 {
						reg = <0x130 0x20>;
					};

					user_key2: user-key@150 {
						reg = <0x150 0x20>;
					};

					user_key3: user-key@170 {
						reg = <0x170 0x20>;
					};

					user_key4: user-key@190 {
						reg = <0x190 0x20>;
					};

					user_key5: user-key@1b0 {
						reg = <0x1b0 0x20>;
					};

					user_key6: user-key@1d0 {
						reg = <0x1d0 0x20>;
					};

					user_key7: user-key@1f0 {
						reg = <0x1f0 0x20>;
					};
				};
			};
		};
	};

	zynqmp-ipi {
		compatible = "xlnx,zynqmp-ipi-mailbox";
		interrupt-parent = <&gic>;
		interrupts = <0 57 4>;
		xlnx,ipi-id = <2>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ipi_mailbox_pmu1: mailbox@eb3f0440 {
			compatible = "xlnx,zynqmp-ipi-dest-mailbox";
			reg = <0 0xeb3f0440 0 0x20>,
			      <0 0xeb3f0460 0 0x20>,
			      <0 0xeb3f0280 0 0x20>,
			      <0 0xeb3f02a0 0 0x20>;
			reg-names = "local_request_region", "local_response_region",
				    "remote_request_region", "remote_response_region";
			#mbox-cells = <1>;
			xlnx,ipi-id = <1>;
		};
	};

	ref_clk: ref-clk {
		bootph-all;
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <33333333>;
		clock-output-names = "board_ref_clk";
	};

	rtc_clk: rtc-clk {
		bootph-all;
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "rtc_clk";
	};

	can0_clk: can0-clk {
		#clock-cells = <0>;
		compatible = "fixed-factor-clock";
		clocks = <&scmi_clk SCMI_CLK_VERSAL2_CAN0_REF_2X>;
		clock-div = <2>;
		clock-mult = <1>;
	};

	can1_clk: can1-clk {
		#clock-cells = <0>;
		compatible = "fixed-factor-clock";
		clocks = <&scmi_clk SCMI_CLK_VERSAL2_CAN1_REF_2X>;
		clock-div = <2>;
		clock-mult = <1>;
	};

	can2_clk: can2-clk {
		#clock-cells = <0>;
		compatible = "fixed-factor-clock";
		clocks = <&scmi_clk SCMI_CLK_VERSAL2_CAN2_REF_2X>;
		clock-div = <2>;
		clock-mult = <1>;
	};

	can3_clk: can3-clk {
		#clock-cells = <0>;
		compatible = "fixed-factor-clock";
		clocks = <&scmi_clk SCMI_CLK_VERSAL2_CAN3_REF_2X>;
		clock-div = <2>;
		clock-mult = <1>;
	};

	clk150: clk150 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <150000000>;
	};

	clk250: clk250 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <250000000>;
	};

	clk256: clk256 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <256000000>;
	};

	ufs_ref_clk: ufs-ref-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* Override in board dts if different from default 26 MHz */
		clock-frequency = <26000000>;
	};
};

&cpu0 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_ACPU_0>;
	/delete-property/ operating-points-v2;
};

&cpu100 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_ACPU_0>;
	/delete-property/ operating-points-v2;
};

&cpu10000 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_ACPU_1>;
	/delete-property/ operating-points-v2;
};

&cpu10100 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_ACPU_1>;
	/delete-property/ operating-points-v2;
};

&cpu20000 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_ACPU_2>;
	/delete-property/ operating-points-v2;
};

&cpu20100 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_ACPU_2>;
