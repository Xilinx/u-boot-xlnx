};

&mmi_dc {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_DC_PIXEL>;
	resets = <&scmi_reset SCMI_RST_VERSAL2_DC>;
};

&gpu_mali {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_PS_AXI_DMA>;
};

&mmi_dptx {
	clock-names = "pixel_clk";
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_DC_PIXEL>;
};
