	power-domains = <&scmi_devpd SCMI_PD_VERSAL2_DEV_CAN_FD_3>;
};

&gem0 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_LPD_LSBUS>,
		 <&scmi_clk SCMI_CLK_VERSAL2_GEM0_REF>, <&scmi_clk SCMI_CLK_VERSAL2_GEM0_TX>,
		 <&scmi_clk SCMI_CLK_VERSAL2_GEM0_RX>, <&scmi_clk SCMI_CLK_VERSAL2_GEM_TSU>;
	power-domains = <&scmi_devpd SCMI_PD_VERSAL2_DEV_GEM_0>;
};

&gem1 {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_LPD_LSBUS>,
		 <&scmi_clk SCMI_CLK_VERSAL2_GEM1_REF>, <&scmi_clk SCMI_CLK_VERSAL2_GEM1_TX>,
		 <&scmi_clk SCMI_CLK_VERSAL2_GEM1_RX>, <&scmi_clk SCMI_CLK_VERSAL2_GEM_TSU>;
	power-domains = <&scmi_devpd SCMI_PD_VERSAL2_DEV_GEM_1>;
};

&mmi_10gbe {
	clocks = <&scmi_clk SCMI_CLK_VERSAL2_LPD_LSBUS>,
		 <&scmi_clk SCMI_CLK_VERSAL2_MMI_GEM_HCLK>, <&clk150>,
		 <&clk250>;
	power-domains = <&scmi_devpd SCMI_PD_VERSAL2_DEV_MMI_GEM>;
};

